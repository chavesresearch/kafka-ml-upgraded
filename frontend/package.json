{
  "name": "kafkaml-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run sync-themes",
    "build": "vue-tsc --noEmit && vite build",
    "prebuild": "npm run sync-themes",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sync-themes": "rm -rf public/themes && mkdir -p public/themes && cp -R node_modules/primevue/resources/themes/lara-light-indigo public/themes/lara-light-indigo && cp -R node_modules/primevue/resources/themes/lara-dark-indigo public/themes/lara-dark-indigo"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.0.18",
    "chart.js": "^4.4.3",
    "monaco-editor": "^0.50.0",
    "primeicons": "^7.0.0",
    "primevue": "^3.53.0",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitest/coverage-v8": "^1.6.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.26"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
